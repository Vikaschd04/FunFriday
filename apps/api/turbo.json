{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "db:generate": {
      "inputs": ["prisma/schema.prisma", "prisma.config.ts"],
      "outputs": ["src/generated/**"]
    },
    "build": { "dependsOn": ["^build", "db:generate"] },
    "lint": { "dependsOn": ["^build", "db:generate"] },
    "typecheck": { "dependsOn": ["^build", "db:generate"] },
    "test": { "dependsOn": ["^build", "db:generate"] },
    "test:integration": { "dependsOn": ["^build", "db:generate"], "cache": false },
    "dev": { "dependsOn": ["^build", "db:generate"], "cache": false, "persistent": true }
  }
}
