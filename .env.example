# DEVELOPMENT EXAMPLE ONLY. Copy to `.env` at the repo root: `cp .env.example .env`.
# Never use these sample credentials in staging/production; never commit `.env`.
NODE_ENV=development

# API (NestJS). Bind 0.0.0.0 only inside containers/behind a proxy.
API_HOST=127.0.0.1
API_PORT=4000
# APP_VERSION=  # optional; defaults to apps/api/package.json version (CI may set a git SHA)

# Data stores (infra/docker-compose.yml)
DATABASE_URL=postgresql://funfriday_dev:funfriday_local_only_change_me@localhost:5432/funfriday_dev?schema=public
# Integration tests migrate and use this separate database; never point it at real data.
TEST_DATABASE_URL=postgresql://funfriday_dev:funfriday_local_only_change_me@localhost:5432/funfriday_test?schema=public
REDIS_URL=redis://localhost:6379

# Auth (ADR 0002). AUTH_SECRET signs sessions/tokens: >= 32 random chars, unique per
# environment, never committed. Generate one with: openssl rand -base64 32
AUTH_SECRET=replace-with-output-of-openssl-rand-base64-32
# Public origin of the API (cookies, verification links).
API_PUBLIC_URL=http://localhost:4000
# Local-only email stand-in: verification mail lands in a dev mailbox page instead of
# being sent. Refused when NODE_ENV=production.
DEV_MAILBOX_ENABLED=true

# Number of trusted reverse-proxy hops (0-5). 0 = no proxy: X-Forwarded-For is ignored so
# clients cannot spoof their IP. Behind one proxy that overwrites X-Forwarded-For, use 1.
TRUST_PROXY=0

# Browser origins allowed by API CORS (comma-separated exact origins)
WEB_ORIGIN=http://localhost:3000

# Web (Next.js) - public values are inlined into the browser bundle at build time.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

# Generate and store production secrets securely (secret manager). Do NOT commit real values.
# MAIL_PROVIDER_API_KEY=
# OBJECT_STORAGE_ACCESS_KEY=
# OUTLOOK_CLIENT_SECRET=
# GOOGLE_CALENDAR_CLIENT_SECRET=
