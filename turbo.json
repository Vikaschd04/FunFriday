{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalDependencies": ["tsconfig.json"],
  "globalPassThroughEnv": [
    "CI",
    "DATABASE_URL",
    "TEST_DATABASE_URL",
    "REDIS_URL",
    "WEB_ORIGIN",
    "API_PORT",
    "API_HOST",
    "LOG_LEVEL",
    "PLAYWRIGHT_BROWSERS_PATH",
    "AUTH_SECRET",
    "API_PUBLIC_URL",
    "DEV_MAILBOX_ENABLED",
    "TRUST_PROXY"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["NEXT_PUBLIC_*", "NODE_ENV"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:integration": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    }
  }
}
