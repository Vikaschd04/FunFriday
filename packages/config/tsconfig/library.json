{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "FunFriday ESM library (NodeNext, emits JS + declarations)",
  "extends": "./base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  }
}
