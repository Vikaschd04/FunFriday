{
  "name": "@funfriday/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "FunFriday brand tokens and (from P1) shared accessible UI components.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens.css": {
      "style": "./src/tokens/tokens.css",
      "default": "./src/tokens/tokens.css"
    },
    "./theme.css": {
      "style": "./src/theme.css",
      "default": "./src/theme.css"
    }
  },
  "files": [
    "dist",
    "src/tokens/tokens.css",
    "src/theme.css"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@funfriday/config": "workspace:*",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.12.0",
    "jsdom": "30.1.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  },
  "peerDependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "dependencies": {
    "lucide-react": "1.57.0"
  }
}
