{
  "name": "@funfriday/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "FunFriday brand tokens and (from P1) shared accessible UI components.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens.css": {
      "style": "./src/tokens/tokens.css",
      "default": "./src/tokens/tokens.css"
    }
  },
  "files": [
    "dist",
    "src/tokens/tokens.css"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@funfriday/config": "workspace:*",
    "@types/node": "22.20.5",
    "eslint": "10.12.0",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
